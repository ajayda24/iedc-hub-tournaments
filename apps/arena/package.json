{
  "name": "@iedc/arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brain Arena LAN server: serves the web app and runs live tournaments over Socket.IO",
  "scripts": {
    "dev": "tsx watch src/index.ts --dev",
    "start": "tsx src/index.ts",
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bots": "tsx scripts/bots.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@iedc/shared": "workspace:*",
    "fastify": "^5.6.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
