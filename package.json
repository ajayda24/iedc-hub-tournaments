{
  "name": "iedc-hub-tournaments",
  "private": true,
  "description": "Brain Arena — offline-first LAN tournament platform for quick logic games (IEDC)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/use-college.mjs && pnpm --parallel --filter @iedc/arena --filter @iedc/web dev",
    "dev:arena": "node scripts/use-college.mjs && pnpm --filter @iedc/arena dev",
    "dev:web": "node scripts/use-college.mjs && pnpm --filter @iedc/web dev",
    "build": "node scripts/use-college.mjs && pnpm --filter @iedc/web build && pnpm --filter @iedc/arena build",
    "start": "node scripts/use-college.mjs && pnpm --filter @iedc/arena start",
    "test": "node scripts/use-college.mjs && pnpm -r --if-present test",
    "typecheck": "node scripts/use-college.mjs && pnpm -r --if-present typecheck",
    "bots": "pnpm --filter @iedc/arena bots",
    "recover:first": "pnpm --filter @iedc/arena recover:first",
    "pack:arena": "node scripts/use-college.mjs && node scripts/pack-arena.mjs",
    "test:e2e": "node scripts/use-college.mjs && playwright test",
    "content:build": "pnpm --filter @iedc/shared content:build",
    "postinstall": "node scripts/use-college.mjs --quiet"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "playwright-core": "1.56.1"
  }
}
